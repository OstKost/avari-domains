PORT=8080
CHECK_REGION=Москва
DNS_RESOLVER=77.88.8.8,1.1.1.1,8.8.8.8
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
# Укажите IP доверенного reverse proxy через запятую; по умолчанию заголовки proxy игнорируются.
TRUSTED_PROXY_IPS=
# Партнёрские ссылки при наличии ID. {domain} заменяется на URL-кодированный домен.
