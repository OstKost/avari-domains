NAMECHEAP_URL=
GODADDY_URL=
REG_RU_URL=
TIMEWEB_URL=

# Аналитика и метрики (Яндекс.Метрика)
# Номер счетчика Яндекс.Метрики
VITE_YM_ID=113253415
# Включение Вебвизора в Яндекс.Метрике (true / false)
VITE_YM_WEBVISOR=true
# Measurement ID Google Analytics 4 (опционально, например, G-XXXXXXXXXX)
VITE_GA_ID=
